<Window
    x:Class="RF4AssistantPro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:RF4AssistantPro.Views"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="RF4 Assistant Pro"
    Icon="Assets/AppIcon.ico"
    Width="1440"
    Height="920"
    MinWidth="1200"
    MinHeight="720"
    Background="{StaticResource WindowBackgroundBrush}"
    WindowStyle="None"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="41"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="#202731"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="#2A3440"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="#C94F45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="#A93C34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="42"
            CornerRadius="10"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="#0E1115"
            BorderBrush="#222B35"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Image
                        Width="20"
                        Height="20"
                        Source="/RF4AssistantPro;component/Assets/AppIcon.ico"/>
                    <TextBlock
                        Margin="9,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="RF4 Assistant Pro"/>
                    <Border
                        Margin="9,0,0,0"
                        Padding="7,2"
                        VerticalAlignment="Center"
                        Background="#172A43"
                        CornerRadius="8">
                        <TextBlock
                            Foreground="#8FC1FF"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Text="{Binding VersionLabel}"/>
                    </Border>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Orientation="Horizontal">
                    <Button
                        Style="{StaticResource CaptionButtonStyle}"
                        Click="MinimizeWindowClick"
                        ToolTip="Свернуть">
                        <TextBlock
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Text="&#x2014;"/>
                    </Button>
                    <Button
                        Style="{StaticResource CaptionButtonStyle}"
                        Click="ToggleMaximizeWindowClick"
                        ToolTip="Развернуть">
                        <TextBlock
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Text="&#x25A1;"/>
                    </Button>
                    <Button
                        Style="{StaticResource CloseCaptionButtonStyle}"
                        Click="CloseWindowClick"
                        ToolTip="Закрыть">
                        <TextBlock
                            FontFamily="Segoe UI"
                            FontSize="16"
                            Text="&#x00D7;"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <views:StatisticsView Grid.Row="1"/>
    </Grid>
</Window>
