<Window
    x:Class="RF4AssistantPro.Views.BaitCatalogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Наживки"
    Width="1050"
    Height="720"
    MinWidth="900"
    MinHeight="600"
    Background="{StaticResource WindowBackgroundBrush}"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Наживки"/>
            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Ручной каталог для исправления OCR и изображений в карточках улова."/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}">
            <TabItem Header="Каталог">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <TextBox x:Name="SearchBox" Width="310" Height="34"
                                 TextChanged="SearchChanged"
                                 ToolTip="Поиск по названию, категории или производителю"/>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding CatalogCountText}"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" x:Name="CatalogGrid"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionChanged="CatalogSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="68">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Width="48" Height="48" Margin="3"
                                               Source="{Binding ImagePath}" Stretch="Uniform"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Название" Width="2*"
                                                Binding="{Binding DisplayName}"/>
                            <DataGridTextColumn Header="Категория" Width="2*"
                                                Binding="{Binding CategoryDisplay}"/>
                            <DataGridTextColumn Header="Варианты OCR" Width="2.4*"
                                                Binding="{Binding Aliases}"/>
                            <DataGridCheckBoxColumn Header="Активна" Width="75"
                                                    Binding="{Binding IsEnabled}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem x:Name="EditorTab" Header="Добавление и изменение">
                <Grid Margin="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Padding="12" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <Image x:Name="PreviewImage" Height="230" Stretch="Uniform"/>
                            <Button Margin="0,12,0,0" Height="36" Click="ChooseImageClick"
                                    Content="Выбрать изображение"/>
                            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="Можно загрузить карточку или отдельную иконку наживки."/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="1" Margin="24,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Название"/>
                        <TextBox Grid.Column="1" x:Name="NameBox" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Производитель"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="BrandBox" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Категория"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CategoryBox"
                                  Margin="0,0,0,10" IsEditable="True"/>
                        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Подкатегория"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="SubcategoryBox"
                                  Margin="0,0,0,10" IsEditable="True"/>
                        <TextBlock Grid.Row="4" VerticalAlignment="Top" Margin="0,5,0,0"
                                   Text="Варианты OCR"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="AliasesBox"
                                 Height="75" AcceptsReturn="True" TextWrapping="Wrap"
                                 ToolTip="Разделяйте варианты точкой с запятой"/>
                        <CheckBox Grid.Row="5" Grid.Column="1" x:Name="EnabledBox"
                                  Margin="0,12,0,0" IsChecked="True"
                                  Content="Использовать при распознавании"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,20,0,0"
                                    Orientation="Horizontal">
                            <Button Width="120" Height="38" Click="NewClick" Content="Новая"/>
                            <Button Width="120" Height="38" Margin="8,0,0,0"
                                    Click="SaveClick" Content="Сохранить"
                                    Background="#7FA83A"/>
                            <Button Width="120" Height="38" Margin="8,0,0,0"
                                    Click="DeleteClick" Content="Удалить"/>
                        </StackPanel>
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="EditorStatus"
                                   Margin="0,14,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Нераспознанные">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="UnrecognizedGrid" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Время" Width="150"
                                                Binding="{Binding CapturedAtDisplay}"/>
                            <DataGridTextColumn Header="Результат OCR" Width="220"
                                                Binding="{Binding CandidateName}"/>
                            <DataGridTextColumn Header="Полный текст" Width="*"
                                                Binding="{Binding RawText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal">
                        <Button Width="190" Height="38" Click="CreateFromUnrecognizedClick"
                                Content="Создать запись"/>
                        <Button Width="190" Height="38" Margin="8,0,0,0"
                                Click="DeleteUnrecognizedClick"
                                Content="Удалить из очереди"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>