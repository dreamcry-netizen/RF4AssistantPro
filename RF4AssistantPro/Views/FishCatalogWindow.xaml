<Window
    x:Class="RF4AssistantPro.Views.FishCatalogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Каталог рыбы"
    Width="1160"
    Height="760"
    MinWidth="980"
    MinHeight="640"
    Background="{StaticResource WindowBackgroundBrush}"
    Foreground="{StaticResource PrimaryTextBrush}"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <StackPanel>
                <TextBlock FontSize="27" FontWeight="SemiBold" Text="Каталог рыбы"/>
                <TextBlock Margin="0,4,0,0" Foreground="#98A3B3" Text="Изображения, семейства, места обитания и трофейный вес."/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox
                    x:Name="SearchBox"
                    Width="250"
                    TextChanged="SearchChanged"
                    ToolTip="Поиск по названию, семейству и псевдонимам"/>
                <Button Margin="10,0,0,0" Click="NewClick" Content="+ Новая рыба"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                <DataGrid
                    x:Name="CatalogGrid"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    SelectionChanged="CatalogSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="52" Height="52" Margin="4" Background="#0E1115" CornerRadius="7">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#697586" FontSize="20" Text="🐟"/>
                                            <Image Source="{Binding ImagePath}" Stretch="Uniform"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Рыба" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Семейство" Binding="{Binding Family}" Width="150"/>
                        <DataGridTextColumn Header="Обитание" Binding="{Binding HabitatDisplay}" Width="150"/>
                        <DataGridTextColumn Header="Трофей" Binding="{Binding TrophyWeightDisplay}" Width="95"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Карточка рыбы"/>
                        <Border Height="165" Margin="0,14,0,12" Background="#0E1115" CornerRadius="9">
                            <Grid>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#697586" FontSize="42" Text="🐟"/>
                                <Image x:Name="PreviewImage" Stretch="Uniform"/>
                            </Grid>
                        </Border>
                        <Button Click="ChooseImageClick" Content="Выбрать изображение"/>

                        <TextBlock Margin="0,15,0,5" Foreground="#98A3B3" Text="Название"/>
                        <TextBox x:Name="NameBox"/>
                        <TextBlock Margin="0,11,0,5" Foreground="#98A3B3" Text="Семейство"/>
                        <TextBox x:Name="FamilyBox"/>
                        <TextBlock Margin="0,11,0,5" Foreground="#98A3B3" Text="Место обитания"/>
                        <TextBox x:Name="HabitatBox"/>
                        <TextBlock Margin="0,11,0,5" Foreground="#98A3B3" Text="Псевдонимы через ;"/>
                        <TextBox x:Name="AliasesBox"/>
                        <TextBlock Margin="0,15,0,5" Foreground="#98A3B3" Text="Водоёмы через ;"/>
                        <TextBox
                            x:Name="WaterBodiesBox"
                            Height="52"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            ToolTip="Например: р. Вьюнок; р. Белая; р. Волхов"/>

                        <TextBlock Margin="0,15,0,5" Foreground="#98A3B3" Text="Параметры карточки"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Foreground="#98A3B3" Text="Клёв"/>
                                <TextBox x:Name="BiteActivityBox"/>
                                <TextBlock Margin="0,8,0,0" Foreground="#98A3B3" Text="Популяция"/>
                                <TextBox x:Name="PopulationBox"/>
                                <TextBlock Margin="0,8,0,0" Foreground="#98A3B3" Text="Слой"/>
                                <TextBox x:Name="LayerBox"/>
                                <TextBlock Margin="0,8,0,0" Foreground="#98A3B3" Text="Время"/>
                                <TextBox x:Name="BestTimeBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Foreground="#98A3B3" Text="Тип трофея"/>
                                <TextBox x:Name="TrophyTypeBox"/>
                                <TextBlock Margin="0,8,0,0" Foreground="#98A3B3" Text="Крючок"/>
                                <TextBox x:Name="HookBox"/>
                                <TextBlock Margin="0,8,0,0" Foreground="#98A3B3" Text="Поводок"/>
                                <TextBox x:Name="LeaderBox"/>
                                <TextBlock Margin="0,8,0,0" Foreground="#98A3B3" Text="Цена карточки"/>
                                <TextBox x:Name="CardPriceBox"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,15,0,5" Foreground="#98A3B3" Text="Контрольные веса, г"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Foreground="#98A3B3" Text="Синий трофей"/>
                                <TextBox x:Name="BlueTrophyWeightBox"/>
                                <TextBlock Margin="0,8,0,0" Foreground="#98A3B3" Text="Минимальный"/>
                                <TextBox x:Name="MinimumWeightBox"/>
                                <TextBlock Margin="0,8,0,0" Foreground="#98A3B3" Text="Зачётный"/>
                                <TextBox x:Name="QualifyingWeightBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Foreground="#98A3B3" Text="Чатовый"/>
                                <TextBox x:Name="ChatWeightBox"/>
                                <TextBlock Margin="0,8,0,0" Foreground="#98A3B3" Text="Максимальный"/>
                                <TextBox x:Name="MaximumWeightBox"/>
                                <TextBlock Margin="0,8,0,0" Foreground="#98A3B3" Text="Трофейный"/>
                                <TextBox x:Name="TrophyWeightBox"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,15,0,5" Foreground="#98A3B3" Text="Кратко"/>
                        <TextBox
                            x:Name="DescriptionBox"
                            Height="120"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Margin="0,11,0,5" Foreground="#98A3B3" Text="Советы"/>
                        <TextBox
                            x:Name="TipsBox"
                            Height="72"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Margin="0,11,0,5" Foreground="#98A3B3" Text="Наживки из справочника через ;"/>
                        <TextBox
                            x:Name="BaitHintsBox"
                            Height="52"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"/>
                        <TextBlock Margin="0,11,0,5" Foreground="#98A3B3" Text="Вес, цена и опыт"/>
                        <UniformGrid Columns="2">
                            <Border Margin="0,0,5,6" Padding="8" Background="#171C22" BorderBrush="#2B3642" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Незачётная"/>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,3,0">
                                            <TextBlock Foreground="#98A3B3" FontSize="10" Text="Кг"/>
                                            <TextBox x:Name="NonQualifyingKgBox" ToolTip="Например: 0,003 – 0,059"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0">
                                            <TextBlock Foreground="#98A3B3" FontSize="10" Text="Цена"/>
                                            <TextBox x:Name="NonQualifyingPriceBox" ToolTip="Например: 4,97 – 4,97"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                            <TextBlock Foreground="#98A3B3" FontSize="10" Text="Опыт"/>
                                            <TextBox x:Name="NonQualifyingExperienceBox" ToolTip="Например: 226 – 226"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Margin="5,0,0,6" Padding="8" Background="#122A25" BorderBrush="#23704F" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Зачётная"/>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,3,0">
                                            <TextBlock Foreground="#98A3B3" FontSize="10" Text="Кг"/>
                                            <TextBox x:Name="QualifyingKgBox" ToolTip="Например: 0,06 – 0,249"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0">
                                            <TextBlock Foreground="#98A3B3" FontSize="10" Text="Цена"/>
                                            <TextBox x:Name="QualifyingPriceBox" ToolTip="Например: 5 – 16"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                            <TextBlock Foreground="#98A3B3" FontSize="10" Text="Опыт"/>
                                            <TextBox x:Name="QualifyingExperienceBox" ToolTip="Например: 226 – 939"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,5,0" Padding="8" Background="#282821" BorderBrush="#B58A22" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Трофей"/>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,3,0">
                                            <TextBlock Foreground="#98A3B3" FontSize="10" Text="Кг"/>
                                            <TextBox x:Name="TrophyKgBox" ToolTip="Например: 0,25 – 0,389"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0">
                                            <TextBlock Foreground="#98A3B3" FontSize="10" Text="Цена"/>
                                            <TextBox x:Name="TrophyPriceBox" ToolTip="Например: 16,55 – 25,02"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                            <TextBlock Foreground="#98A3B3" FontSize="10" Text="Опыт"/>
                                            <TextBox x:Name="TrophyExperienceBox" ToolTip="Например: 1944 – 3025"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Margin="5,0,0,0" Padding="8" Background="#172C3B" BorderBrush="#4C8BC2" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Синий трофей"/>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,3,0">
                                            <TextBlock Foreground="#98A3B3" FontSize="10" Text="Кг"/>
                                            <TextBox x:Name="BlueTrophyKgBox" ToolTip="Например: 0,39 – 0,449"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0">
                                            <TextBlock Foreground="#98A3B3" FontSize="10" Text="Цена"/>
                                            <TextBox x:Name="BlueTrophyPriceBox" ToolTip="Например: 25,08 – 28,68"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                            <TextBlock Foreground="#98A3B3" FontSize="10" Text="Опыт"/>
                                            <TextBox x:Name="BlueTrophyExperienceBox" ToolTip="Например: 3032 – 3491"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <CheckBox x:Name="EnabledBox" Margin="0,13,0,0" Content="Использовать запись" IsChecked="True"/>

                        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                            <Button Width="112" Background="#4E96EF" Click="SaveClick" Content="Сохранить"/>
                            <Button Width="92" Margin="8,0,0,0" Click="DeleteClick" Content="Удалить"/>
                        </StackPanel>
                        <TextBlock x:Name="EditorStatus" Margin="0,12,0,0" Foreground="#98A3B3" TextWrapping="Wrap" Text="Выберите запись или создайте новую."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,14,0,0" Foreground="#697586" Text="{Binding CatalogCountText}"/>
    </Grid>
</Window>
