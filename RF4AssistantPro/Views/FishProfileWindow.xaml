<Window
    x:Class="RF4AssistantPro.Views.FishProfileWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Карточка рыбы"
    Width="1040"
    Height="760"
    MinWidth="900"
    MinHeight="650"
    Background="{StaticResource WindowBackgroundBrush}"
    Foreground="{StaticResource PrimaryTextBrush}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="42"
            CornerRadius="10"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="#0E1115"
            BorderBrush="#222B35"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
            <Grid>
                <TextBlock
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="Карточка рыбы"/>
                <Button
                    Width="44"
                    Height="42"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CloseClick"
                    Focusable="False"
                    IsTabStop="False"
                    Panel.ZIndex="2"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    FontFamily="Segoe UI"
                    FontSize="20"
                    Content="&#x00D7;"
                    ToolTip="Закрыть"/>
            </Grid>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            Padding="24,18,24,24"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border
                    Padding="22"
                    Background="#17202C"
                    BorderBrush="#283849"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="290"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Height="150"
                            Background="#0B1017"
                            BorderBrush="#2B3A4A"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="#697586"
                                    FontSize="42"
                                    Text="◈"/>
                                <Image
                                    Source="{Binding ImagePath}"
                                    Stretch="Uniform"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Text="{Binding Name, TargetNullValue='Выберите рыбу'}"/>
                                <Border
                                    Margin="12,2,0,0"
                                    Padding="10,4"
                                    Background="#172A43"
                                    BorderBrush="#4E96EF"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <TextBlock
                                        Foreground="#8FC1FF"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{Binding RarityDisplay}"/>
                                </Border>
                            </StackPanel>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border
                                    Margin="0,0,6,0"
                                    Padding="16,10"
                                    Background="#282821"
                                    BorderBrush="#B58A22"
                                    BorderThickness="2"
                                    CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="#FFD21A"
                                            FontSize="22"
                                            Text="★"/>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="#FFD21A"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Text="ТРОФЕЙ"/>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="#FFD21A"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Text="{Binding TrophyWeightDisplay}"/>
                                    </StackPanel>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Padding="16,10"
                                    Background="#172C3B"
                                    BorderBrush="#4C8BC2"
                                    BorderThickness="2"
                                    CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="#1DB8FF"
                                            FontSize="22"
                                            Text="♛"/>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="#47B9FF"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Text="СИНИЙ ТРОФЕЙ"/>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="#8FC1FF"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Text="{Binding BlueTrophyWeightDisplay}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <Border
                                    Width="34"
                                    Height="28"
                                    Margin="0,0,8,0"
                                    Background="#202731"
                                    BorderBrush="#344253"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="#98A3B3"
                                        Text="▤"/>
                                </Border>
                                <Border
                                    Width="34"
                                    Height="28"
                                    Background="#202731"
                                    BorderBrush="#344253"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="#98A3B3"
                                        Text="♜"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <UniformGrid
                    Margin="0,10,0,0"
                    Columns="4">
                    <Border
                        Margin="0,0,6,0"
                        Padding="10,7"
                        Background="#10161F"
                        BorderBrush="#273341"
                        BorderThickness="1"
                        CornerRadius="9">
                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="#98A3B3"
                                FontSize="10"
                                Text="МИН."/>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontWeight="Bold"
                                Text="{Binding MinimumWeightDisplay}"/>
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="6,0"
                        Padding="10,7"
                        Background="#122A25"
                        BorderBrush="#23704F"
                        BorderThickness="1"
                        CornerRadius="9">
                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="#72BC8F"
                                FontSize="10"
                                Text="ЗАЧЁТ"/>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="#72BC8F"
                                FontWeight="Bold"
                                Text="{Binding QualifyingWeightDisplay}"/>
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="6,0"
                        Padding="10,7"
                        Background="#17243A"
                        BorderBrush="#356B9D"
                        BorderThickness="1"
                        CornerRadius="9">
                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="#8FC1FF"
                                FontSize="10"
                                Text="ЧАТ"/>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="#8FC1FF"
                                FontWeight="Bold"
                                Text="{Binding ChatWeightDisplay}"/>
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="6,0,0,0"
                        Padding="10,7"
                        Background="#10161F"
                        BorderBrush="#273341"
                        BorderThickness="1"
                        CornerRadius="9">
                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="#98A3B3"
                                FontSize="10"
                                Text="МАКС."/>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontWeight="Bold"
                                Text="{Binding MaximumWeightDisplay}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TabControl
                    Margin="0,18,0,0"
                    Background="#0B0F15">
                    <TabItem Header="🔵  О рыбе">
                        <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock
                                    Foreground="#98A3B3"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Text="{Binding WaterBodyCountDisplay}"/>
                                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding WaterBodyNames}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="0,0,12,6"
                                                Foreground="#4EAAFF"
                                                Text="{Binding}"
                                                TextDecorations="Underline"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Padding="16"
                                        Background="#171C22"
                                        BorderBrush="#2B3642"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock
                                                Foreground="#98A3B3"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Text="ПАРАМЕТРЫ"/>
                                            <WrapPanel Margin="0,12,0,0">
                                                <Border Margin="0,0,6,6" Padding="9,5" Background="#232A32" CornerRadius="12">
                                                    <TextBlock Text="{Binding BiteActivityDisplay, StringFormat=Клёв {0}}"/>
                                                </Border>
                                                <Border Margin="0,0,6,6" Padding="9,5" Background="#232A32" CornerRadius="12">
                                                    <TextBlock Text="{Binding PopulationDisplay, StringFormat=Популяция {0}}"/>
                                                </Border>
                                                <Border Margin="0,0,6,6" Padding="9,5" Background="#232A32" CornerRadius="12">
                                                    <TextBlock Text="{Binding LayerDisplay, StringFormat=Слой {0}}"/>
                                                </Border>
                                                <Border Margin="0,0,6,6" Padding="9,5" Background="#232A32" CornerRadius="12">
                                                    <TextBlock Text="{Binding BestTimeDisplay, StringFormat=Время {0}}"/>
                                                </Border>
                                                <Border Margin="0,0,6,6" Padding="9,5" Background="#232A32" CornerRadius="12">
                                                    <TextBlock Text="{Binding TrophyTypeDisplay, StringFormat=Трофей {0}}"/>
                                                </Border>
                                                <Border Margin="0,0,6,6" Padding="9,5" Background="#232A32" CornerRadius="12">
                                                    <TextBlock Text="{Binding HookDisplay, StringFormat=Крючок {0}}"/>
                                                </Border>
                                                <Border Margin="0,0,6,6" Padding="9,5" Background="#232A32" CornerRadius="12">
                                                    <TextBlock Text="{Binding LeaderDisplay, StringFormat=Поводок {0}}"/>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Grid.Column="2"
                                        Padding="16"
                                        Background="#171C22"
                                        BorderBrush="#2B3642"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock
                                                Foreground="#98A3B3"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Text="КРАТКО"/>
                                            <TextBlock
                                                Margin="0,12,0,0"
                                                FontSize="14"
                                                LineHeight="22"
                                                Text="{Binding DescriptionDisplay}"
                                                TextWrapping="Wrap"/>
                                            <TextBlock
                                                Margin="0,18,0,0"
                                                Foreground="#98A3B3"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Text="СОВЕТЫ"/>
                                            <TextBlock
                                                Margin="0,7,0,0"
                                                Text="{Binding TipsDisplay}"
                                                TextWrapping="Wrap"/>
                                            <TextBlock
                                                Margin="0,8,0,0"
                                                Text="{Binding CardPriceDisplay, StringFormat=💵  Цена карточки — {0}}"
                                                TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="⚖  Вес, цена и опыт">
                        <ItemsControl
                            Margin="12"
                            ItemsSource="{Binding RateBandsDisplay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="5"
                                        Padding="14"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="#171C22"/>
                                                <Setter Property="BorderBrush" Value="#2B3642"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="Чатовая">
                                                        <Setter Property="Background" Value="#10231F"/>
                                                        <Setter Property="BorderBrush" Value="#23704F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Зачётная">
                                                        <Setter Property="Background" Value="#122A25"/>
                                                        <Setter Property="BorderBrush" Value="#23704F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Трофей">
                                                        <Setter Property="Background" Value="#282821"/>
                                                        <Setter Property="BorderBrush" Value="#B58A22"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Name}" Value="Синий трофей">
                                                        <Setter Property="Background" Value="#172C3B"/>
                                                        <Setter Property="BorderBrush" Value="#4C8BC2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Text="{Binding Name}"/>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Foreground="#98A3B3" Text="Кг"/>
                                                    <TextBlock Margin="0,6,0,0" Foreground="#98A3B3" Text="Цена"/>
                                                    <TextBlock Margin="0,6,0,0" Foreground="#98A3B3" Text="Опыт"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding WeightDisplay}"/>
                                                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding PriceDisplay}"/>
                                                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding ExperienceDisplay}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>

                    <TabItem Header="〰  Наживки">
                        <StackPanel Margin="16">
                            <Border
                                Margin="0,8,0,0"
                                Padding="14"
                                Background="#171C22"
                                BorderBrush="#2B3642"
                                BorderThickness="1"
                                CornerRadius="11">
                                <StackPanel>
                                    <TextBlock
                                        Foreground="#98A3B3"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Text="СПРАВОЧНЫЕ НАЖИВКИ"/>
                                    <ItemsControl
                                        Margin="0,7,0,0"
                                        ItemsSource="{Binding ReferenceBaitNames}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,6,6"
                                                    Padding="9,5"
                                                    Background="#232A32"
                                                    CornerRadius="12">
                                                    <TextBlock Text="{Binding}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Foreground="#98A3B3"
                                FontSize="12"
                                FontWeight="Bold"
                                Text="НАЖИВКИ, НА КОТОРЫЕ ПОЙМАНА РЫБА"/>
                            <TextBlock
                                Margin="0,7,0,0"
                                Foreground="#98A3B3"
                                Text="{Binding BaitStatisticsSummary}"/>
                            <ItemsControl
                                Margin="0,14,0,0"
                                ItemsSource="{Binding BaitStatistics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="12,9"
                                            Background="#141A21"
                                            BorderBrush="#2B3642"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="250"/>
                                                    <ColumnDefinition Width="170"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="#98A3B3"
                                                    FontSize="15"
                                                    FontWeight="Bold"
                                                    Text="{Binding CatchCount}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{Binding BaitName}"/>
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        Foreground="#98A3B3"
                                                        FontSize="11"
                                                        Text="{Binding LastCaughtDisplay, StringFormat=Последний улов: {0}}"/>
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    Margin="18,0,18,0"
                                                    VerticalAlignment="Center">
                                                    <ProgressBar
                                                        Height="8"
                                                        Maximum="100"
                                                        Value="{Binding CatchCount}"/>
                                                    <TextBlock
                                                        Margin="0,5,0,0"
                                                        Foreground="#72BC8F"
                                                        FontSize="11"
                                                        Text="{Binding CatchCountDisplay}"/>
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="3"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        Foreground="#98A3B3"
                                                        FontSize="11"
                                                        Text="{Binding AverageWeightDisplay, StringFormat=Средний: {0}}"/>
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        Foreground="#8FC1FF"
                                                        FontSize="11"
                                                        Text="{Binding BestWeightDisplay, StringFormat=Лучший: {0}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>