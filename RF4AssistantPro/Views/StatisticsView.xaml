                                                                Binding="{Binding CatchCount}"
                                                                Width="70"/>
                                            <DataGridTextColumn Header="Вес"
                                                                Binding="{Binding TotalWeightDisplay}"
                                                                Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="По рыбе: вес и результат"/>
                                    <DataGrid Margin="0,8,0,0"
                                              MaxHeight="230"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              ItemsSource="{Binding FishAnalytics}">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Рыба" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="28" Height="28" Margin="0,2,7,2" Background="#182C24" CornerRadius="14">
                                                                <Grid>
                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Text="🐟"/>
                                                                    <Image Margin="3" Source="{Binding FishImagePath}" Stretch="Uniform"/>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock VerticalAlignment="Center" Text="{Binding Label}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Уловов"
                                                                Binding="{Binding CatchCount}"
                                                                Width="70"/>
                                            <DataGridTextColumn Header="Средний"
                                                                Binding="{Binding AverageWeightDisplay}"
                                                                Width="100"/>
                                            <DataGridTextColumn Header="Лучший"
                                                                Binding="{Binding BestWeightDisplay}"
                                                                Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="По наживке: вес и результат"/>
                                    <DataGrid Margin="0,8,0,0"
                                              MaxHeight="230"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              ItemsSource="{Binding BaitAnalytics}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Наживка"
                                                                Binding="{Binding Label}"
                                                                Width="*"/>
                                            <DataGridTextColumn Header="Уловов"
                                                                Binding="{Binding CatchCount}"
                                                                Width="70"/>
                                            <DataGridTextColumn Header="Средний"
                                                                Binding="{Binding AverageWeightDisplay}"
                                                                Width="100"/>
                                            <DataGridTextColumn Header="Лучший"
                                                                Binding="{Binding BestWeightDisplay}"
                                                                Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Grid>
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource SmallLabelStyle}"
                                       Text="Вес считается только для распознанных значений; пустые наживки и водоёмы не скрываются."/>
                        </StackPanel>
                    </Border>

                    <StackPanel
                        Margin="0,0,0,12"
                        Orientation="Horizontal">
                        <Button
                            Command="{Binding LoadCommand}"
                            Content="Загрузить"/>
                        <Button
                            Margin="8,0,0,0"
                            Command="{Binding SaveCommand}"
                            Content="Сохранить"/>
                        <Button
                            Margin="8,0,0,0"
                            Command="{Binding ClearCatchesCommand}"
                            Content="Очистить уловы"/>
                        <Button
                            Margin="8,0,0,0"
                            Click="OpenLogsClick"
                            Content="Логи"/>
                    </StackPanel>

                    <Border Margin="0,0,0,12"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Сессия рыбалки"/>
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#98A3B3"
                                       Text="{Binding FishingSessionStatus}"
                                       TextWrapping="Wrap"/>
                            <StackPanel Margin="0,12,0,0"
                                        Orientation="Horizontal">
                                <Button Command="{Binding StartFishingSessionCommand}"
                                        Content="Начать сессию"/>
                                <Button Margin="8,0,0,0"
                                        Command="{Binding StopFishingSessionCommand}"
                                        Content="Завершить сессию"/>
                            </StackPanel>
                        </StackPanel>
