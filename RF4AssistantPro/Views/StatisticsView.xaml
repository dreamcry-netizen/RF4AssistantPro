                               Style="{StaticResource SmallLabelStyle}"
                               Text="Сводка и история пойманной рыбы."/>

                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SmallLabelStyle}"
                                           Text="ЛУЧШИЙ УЛОВ"/>
