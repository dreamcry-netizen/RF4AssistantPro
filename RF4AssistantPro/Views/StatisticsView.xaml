                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="74"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="28"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}"/>
                                                    <ProgressBar Grid.Column="1" Height="8" Margin="7,0" Maximum="100" Value="{Binding SharePercent}"/>
                                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Value, StringFormat={}{0:N0}}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="По наживке"/>
                                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding BaitDistribution}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="74"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="28"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}"/>
                                                    <ProgressBar Grid.Column="1" Height="8" Margin="7,0" Maximum="100" Value="{Binding SharePercent}"/>
                                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Value, StringFormat={}{0:N0}}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Margin="0,0,0,12"
                            Style="{StaticResource CardStyle}">
