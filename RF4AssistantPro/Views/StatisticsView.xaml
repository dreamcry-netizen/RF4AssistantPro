                                            <TextBlock FontWeight="SemiBold" Text="Совпадения с уловами"/>
                                            <TextBlock Style="{StaticResource SmallLabelStyle}" Text="Равный вес тоже подходит"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding CafeSnapshots}">
