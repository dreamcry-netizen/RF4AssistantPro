                                        Click="OpenLogsClick"
                                        Content="Открыть логи"/>
                                <Button Margin="8,0,0,0"
                                        Click="ExportDiagnosticsClick"
                                        Content="Создать ZIP"/>
                                <Button Margin="8,0,0,0"
                                        Click="OpenWindowsQaClick"
                                        Content="Windows QA"
                                        ToolTip="Открыть временный ручной QA-чеклист"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Foreground="#98A3B3" Text="{Binding StatusText}" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,4,0,0" Foreground="#98A3B3" Text="{Binding ScreenshotStatus}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

