                    <TextBlock
                        FontSize="29"
                        FontWeight="SemiBold"
                        Text="Водоёмы"/>
                    <TextBlock
                        Margin="0,5,0,20"
                        Style="{StaticResource SmallLabelStyle}"
                        Text="Карточки локаций с отдельной статистикой. Нажмите карточку, чтобы открыть изображение водоёма."/>

