                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Text="🐟"/>
                                                            <Image Margin="3" Source="{Binding FishImagePath}" Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding FishName}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
