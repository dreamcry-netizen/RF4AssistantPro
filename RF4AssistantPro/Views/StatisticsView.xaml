                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="250"
                                    Margin="0,0,16,18"
                                    Padding="0"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OpenWaterBodyClick"
                                    Style="{StaticResource SectionCardStyle}"
                                    ToolTip="{Binding Name}">
                                    <StackPanel>
                                        <Grid Height="296" Background="#0E1115">
                                            <Border CornerRadius="11,11,0,0" ClipToBounds="True">
                                                <Image Source="{Binding CardImagePath}" Stretch="Uniform"/>
                                            </Border>
                                            <Border
                                                Margin="10"
                                                Padding="8,4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="#CC172A43"
                                                CornerRadius="10">
                                                <TextBlock Foreground="#8FC1FF" FontSize="11" FontWeight="Bold" Text="{Binding Order, StringFormat=№ {0}}"/>
                                            </Border>
                                        </Grid>
                                        <StackPanel Margin="14,12,14,0">
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,3,0,0" Style="{StaticResource SmallLabelStyle}" Text="Открыть карточку, статистику и кафе"/>
                                        </StackPanel>
                                        <Grid Margin="14,12,14,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Statistics.CatchCount}"/>
                                                <TextBlock Style="{StaticResource SmallLabelStyle}" Text="уловов"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="16" FontWeight="Bold" Foreground="#8FC1FF" Text="{Binding Statistics.BestWeightDisplay}"/>
                                                <TextBlock Style="{StaticResource SmallLabelStyle}" Text="лучший"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Statistics.UniqueFishCount}"/>
                                                <TextBlock Style="{StaticResource SmallLabelStyle}" Text="видов"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                x:Name="KeepnetPage"
                Grid.Row="1"
                Padding="30,25,30,24"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="29"
                                       FontWeight="SemiBold"
                                       Text="Садок"/>
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource SmallLabelStyle}"
                                       Text="Запись карточек рыбы и проверка по последнему снимку кафе."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button Width="145"
                                    Height="42"
                                    Margin="0,0,10,0"
                                    Click="KeepnetOcrAliasesClick"
                                    Content="OCR-словарь"
                                    ToolTip="Просмотреть и изменить обученные названия садка"/>
                            <Button Width="150"
                                    Height="42"
                                    Margin="0,0,10,0"
                                    Command="{Binding ClearKeepnetCommand}"
                                    Content="Очистить садок"/>
                            <Button Width="190"
                                    Height="42"
                                    Background="#4E96EF"
                                    Click="ArmKeepnetCaptureClick"
                                    Content="Записать садок"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#98A3B3"
                                       Text="Нажмите «Записать садок» и переключитесь в RF4. Первое нажатие C открывает садок и запускает серию снимков каждые 3 секунды. После звукового сигнала прокручивайте список вниз. Второе нажатие C закрывает садок и завершает серию; затем программа распознает все кадры."/>
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="#63A8FF"
                                       Text="{Binding ScreenshotStatus}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,18,0,0"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="Сверка с историей"/>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource SmallLabelStyle}"
                                           Text="{Binding KeepnetComparisonText}"/>
                            </Grid>
                            <TextBlock Margin="0,0,0,10"
                                       Style="{StaticResource SmallLabelStyle}"
                                       Text="{Binding KeepnetReviewText}"/>
                            <DataGrid MinHeight="150"
                                      MaxHeight="360"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding KeepnetComparison}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Рыба" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="28" Height="28" Margin="0,2,7,2" Background="#182C24" CornerRadius="14">
                                                        <Grid>
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Text="🐟"/>
                                                            <Image Margin="3" Source="{Binding FishImagePath}" Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding FishName}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Вес"
                                                        Width="110"
                                                        Binding="{Binding WeightDisplay}"/>
                                    <DataGridTextColumn Header="История"
                                                        Width="90"
                                                        Binding="{Binding HistoryCount}"/>
                                    <DataGridTextColumn Header="Садок"
                                                        Width="80"
                                                        Binding="{Binding KeepnetCount}"/>
                                    <DataGridTextColumn Header="Разница"
                                                        Width="80"
                                                        Binding="{Binding DifferenceDisplay}"/>
                                    <DataGridTemplateColumn Header="Статус"
                                                            Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{Binding StatusBrush}"
                                                           Text="{Binding Status}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,18,0,0"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="Записанная рыба"/>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource SmallLabelStyle}"
                                           Text="{Binding KeepnetCountText}"/>
                            </Grid>
                            <DataGrid x:Name="KeepnetRecordsGrid"
                                      MinHeight="260"
                                      MaxHeight="620"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      MouseDoubleClick="EditSelectedKeepnetDoubleClick"
                                      ItemsSource="{Binding KeepnetRecords}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Записано"
                                                        Width="145"
                                                        Binding="{Binding RecordedAtDisplay}"/>
                                    <DataGridTemplateColumn Header="Рыба" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="28" Height="28" Margin="0,2,7,2" Background="#182C24" CornerRadius="14">
                                                        <Grid>
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Text="🐟"/>
                                                            <Image Margin="3" Source="{Binding FishImagePath}" Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding FishName}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Вес"
                                                        Width="140"
                                                        Binding="{Binding WeightDisplay}"/>
                                    <DataGridTextColumn Header="Пометка"
                                                        Width="130"
                                                        Binding="{Binding CafeMark}"/>
                                    <DataGridTemplateColumn Header="Действие" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Margin="4,2"
                                                        Padding="8,3"
                                                        Tag="{Binding}"
                                                        Click="EditKeepnetRecordClick"
                                                        Content="Исправить"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource SmallLabelStyle}"
                                       Text="При повторном снимке рыба с тем же названием и весом повторно не добавляется."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                x:Name="BaitsPage"
                Grid.Row="1"
                Padding="30,25,30,24"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel>
                    <TextBlock FontSize="29" FontWeight="SemiBold" Text="Наживки"/>
                    <TextBlock Margin="0,5,0,20"
                               Style="{StaticResource SmallLabelStyle}"
                               Text="Текущая наживка и управление каталогом."/>

                    <Border MaxWidth="720"
                            HorizontalAlignment="Left"
                            Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Height="180"
                                    Background="#0E1115"
                                    CornerRadius="8">
                                <Image Source="{Binding CurrentBaitImagePath}"
                                       Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                <TextBlock Style="{StaticResource SmallLabelStyle}"
                                           Text="ТЕКУЩАЯ НАЖИВКА"/>
                                <TextBlock Margin="0,8,0,22"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Text="{Binding CurrentBaitName}"/>
