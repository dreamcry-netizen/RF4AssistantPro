                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image
                                                        Grid.Column="0"
                                                        Width="54"
                                                        Height="40"
                                                        Source="{Binding ThumbnailImage}"
                                                        Stretch="UniformToFill"/>
                                                    <StackPanel Grid.Column="1" Margin="10,0,5,0">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding CapturedAtText}"/>
                                                        <TextBlock Style="{StaticResource SmallLabelStyle}" Text="{Binding OfferCount, StringFormat=Предложений: {0}}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                        <TextBlock HorizontalAlignment="Right" Foreground="#72BC8F" FontSize="17" FontWeight="Bold" Text="{Binding MatchedCatchCount}"/>
                                                        <TextBlock Style="{StaticResource SmallLabelStyle}" Text="совпадений"/>
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="3"
                                                        Width="30"
                                                        Height="30"
                                                        Margin="10,5,0,0"
                                                        Padding="0"
                                                        VerticalAlignment="Top"
                                                        Click="DeleteCafeSnapshotClick"
                                                        Content="✕"
                                                        ToolTip="Удалить снимок"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="AnalyticsSection"
                            Grid.Column="0"
                            Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Рейтинг водоёмов"/>
