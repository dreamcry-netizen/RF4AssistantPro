                    <TextBlock FontSize="29" FontWeight="SemiBold" Text="Каталог рыбы"/>
                    <TextBlock Margin="0,5,0,20" Style="{StaticResource SmallLabelStyle}"
                               Text="Локальная энциклопедия рыб: изображения, семейства, места обитания и трофейный вес."/>

