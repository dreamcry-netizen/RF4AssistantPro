                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Добавленные рыбы"/>
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SmallLabelStyle}" Text="{Binding FishCatalogCountText}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Width="170" Height="38" Margin="12,0,0,0" Click="OpenFishCatalogClick" Content="Открыть каталог"/>
                                <Button Grid.Column="2" Width="160" Height="38" Margin="10,0,0,0" Background="#4E96EF" Click="AddFishClick" Content="+ Добавить рыбу"/>
                            </Grid>
                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource SmallLabelStyle}" Text="Сортировать по:"/>
                                <ComboBox x:Name="FishSortFieldBox" Width="190" Height="36" SelectedIndex="0">
                                    <ComboBoxItem Tag="Name" Content="Названию"/>
                                    <ComboBoxItem Tag="Family" Content="Семейству"/>
                                    <ComboBoxItem Tag="Habitat" Content="Месту обитания"/>
                                    <ComboBoxItem Tag="TrophyWeightGrams" Content="Трофейному весу"/>
                                </ComboBox>
                                <Button x:Name="FishSortButton" Width="160" Height="36" Margin="10,0,0,0" Click="SortFishClick" Content="Сортировать А–Я"/>
