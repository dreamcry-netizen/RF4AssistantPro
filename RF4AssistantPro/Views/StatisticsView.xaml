                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Height="180" Background="#0E1115" CornerRadius="8">
                                <Grid>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#697586" FontSize="48" Text="🐟"/>
                                    <Image Source="{Binding SelectedFishCatalogItem.ImagePath}" Stretch="Uniform"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                <TextBlock Style="{StaticResource SmallLabelStyle}" Text="ВЫБРАННАЯ РЫБА"/>
                                <TextBlock Margin="0,8,0,4" FontSize="24" FontWeight="Bold" Text="{Binding SelectedFishCatalogItem.Name, TargetNullValue='Выберите рыбу'}"/>
