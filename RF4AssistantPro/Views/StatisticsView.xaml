                                <ComboBox x:Name="FishHabitatFilterBox" Width="230" Height="36" Margin="10,0,0,0" ItemsSource="{Binding FishHabitats}" SelectedItem="{Binding SelectedFishHabitatFilter, Mode=TwoWay}"/>
                                <Button Width="150" Height="36" Margin="10,0,0,0" Background="#4E96EF" Click="ShowSelectedFishClick" Content="Показать выбранное"/>
                                <Button Width="105" Height="36" Margin="10,0,0,0" Click="ShowAllFishClick" Content="Показать все"/>
                            </StackPanel>
                            <DataGrid x:Name="FishCatalogPageGrid" MinWidth="1000" MinHeight="220" MaxHeight="520" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      ItemsSource="{Binding FishCatalog}" SelectedItem="{Binding SelectedFishCatalogItem, Mode=TwoWay}" MouseDoubleClick="EditSelectedFishDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="76"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="56" Height="56" Margin="4" Background="#0E1115" CornerRadius="5"><Grid><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#697586" FontSize="22" Text="🐟"/><Image Source="{Binding ImagePath}" Stretch="Uniform"/></Grid></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Название" Width="1.4*" Binding="{Binding Name}"/>
                                    <DataGridTextColumn Header="Семейство" Width="1.15*" Binding="{Binding Family}"/>
                                    <DataGridTextColumn Header="Место обитания" Width="1.5*" Binding="{Binding HabitatDisplay}"/>
                                    <DataGridTextColumn Header="Трофейный вес" Width="1*" Binding="{Binding TrophyWeightDisplay}"/>
                                    <DataGridTextColumn Header="Варианты OCR" Width="1.5*" Binding="{Binding Aliases}"/>
                                    <DataGridCheckBoxColumn Header="Активна" Width="80" Binding="{Binding IsEnabled}"/>
                                    <DataGridTemplateColumn Header="" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Width="105" Height="34" Tag="{Binding}" Click="EditFishClick" Content="Редактировать"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource SmallLabelStyle}" Text="Выберите строку для просмотра; двойной щелчок открывает редактирование."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2"
                    Margin="0"
                    Padding="16,0"
                    Background="#0E1115"
                    BorderBrush="#222B35"
                    BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="#72BC8F"/>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="RF4 Assistant Pro"/>
                        <TextBlock Margin="10,0,0,0" Style="{StaticResource SmallLabelStyle}" Text="•"/>
                        <TextBlock Margin="7,0,0,0" Style="{StaticResource SmallLabelStyle}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SmallLabelStyle}" Text="{Binding GameBindingStatus}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Margin="12,0,0,0" Style="{StaticResource SmallLabelStyle}" Text="{Binding VersionLabel}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
