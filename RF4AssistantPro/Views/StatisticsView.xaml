                                        <DataGridTextColumn Binding="{Binding CatchCount}" Header="Уловов" Width="75"/>
                                        <DataGridTextColumn Binding="{Binding AverageWeightDisplay}" Header="Средний вес" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
