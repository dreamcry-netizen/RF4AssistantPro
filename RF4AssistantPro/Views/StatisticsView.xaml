                                              MaxHeight="230"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              ItemsSource="{Binding PeriodAnalytics}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Период"
                                                                Binding="{Binding PeriodLabel}"
                                                                Width="*"/>
                                            <DataGridTextColumn Header="Уловов"
                                                                Binding="{Binding CatchCount}"
                                                                Width="70"/>
                                            <DataGridTextColumn Header="Вес"
                                                                Binding="{Binding TotalWeightDisplay}"
                                                                Width="90"/>
                                            <DataGridTextColumn Header="Средний"
                                                                Binding="{Binding AverageWeightDisplay}"
                                                                Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="По сессиям"/>
                                    <DataGrid Margin="0,8,0,0"
                                              MaxHeight="230"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              ItemsSource="{Binding SessionAnalytics}">
