                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding CafeCatches}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Binding="{Binding CaughtAt, StringFormat={}{0:dd.MM HH:mm}}"
                                        Header="Время" Width="115"/>
