                                           FontWeight="Bold"
                                           Text="{Binding Summary.BestWaterBody}"/>
                                <TextBlock Style="{StaticResource SmallLabelStyle}"
                                           Text="по максимальному улову"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SmallLabelStyle}"
                                           Text="СРЕДНИЙ ВЕС"/>
