<UserControl
    x:Class="RF4AssistantPro.Views.StatisticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource WindowBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="CardStyle"
               TargetType="Border"
               BasedOn="{StaticResource SectionCardStyle}">
            <Setter Property="Margin" Value="0,0,16,16"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#4E96EF"/>
            <Setter Property="BorderBrush" Value="#63A8FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        <Style x:Key="ToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Padding" Value="13,7"/>
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#98A3B3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="NavChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="NavScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter
                                    Margin="2,0"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </Border>
                            <Border x:Name="ActiveMarker"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Margin="0,5"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="2"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="#202731"/>
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="#344253"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleX" To="1.015" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleY" To="1.015" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="#1B304B"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleX" To="0.99" Duration="0:0:0.04"/>
                                            <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleY" To="0.99" Duration="0:0:0.04"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="Background" Value="#1B304B">
                                <Setter TargetName="ActiveMarker" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="#3B6EA8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7E8A9A"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F7FA"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="#0E1115"
            BorderBrush="#222B35"
            BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel
                    x:Name="SidebarNavigationPanel"
                    DockPanel.Dock="Top"
                    Margin="18,24,18,0">
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,32">
                        <Border
                            Width="36"
                            Height="36"
                            Background="#63A8FF"
                            CornerRadius="10"
                            Padding="3">
                            <Image
                                Stretch="Uniform"
                                Source="/RF4AssistantPro;component/Assets/AppIcon.ico"/>
                        </Border>
                        <StackPanel
                            x:Name="SidebarBrandText"
                            Margin="11,1,0,0">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="RF4 Assistant"/>
                        <TextBlock Style="{StaticResource SmallLabelStyle}" Text="{Binding VersionLabel}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        x:Name="WorkspaceSectionLabel"
                        Margin="12,0,0,9"
                        Foreground="#697586"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Text="РАБОЧЕЕ ПРОСТРАНСТВО"/>
                    <Button
                        x:Name="OverviewButton"
                        Click="OverviewClick"
                        Style="{StaticResource NavButtonStyle}"
                        Background="#1B304B"
                        Foreground="#F5F7FA">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" Margin="0,0,8,0" Background="#172A43" CornerRadius="8"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#63A8FF" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE80F;"/></Border>
                            <TextBlock FontWeight="SemiBold" Text="Обзор"/>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="CatchesButton"
                        Click="CatchesClick"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" Margin="0,0,8,0" Background="#171C22" CornerRadius="8"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#98A3B3" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE8F1;"/></Border>
                            <TextBlock Text="Уловы"/>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="WaterBodiesButton"
                        Click="WaterBodiesClick"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" Margin="0,0,8,0" Background="#171C22" CornerRadius="8"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#98A3B3" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE707;"/></Border>
                            <TextBlock Text="Водоёмы"/>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="CafeButton"
                        Click="CafeClick"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" Margin="0,0,8,0" Background="#171C22" CornerRadius="8"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#98A3B3" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE7B8;"/></Border>
                            <TextBlock Text="Кафе"/>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="KeepnetButton"
                        Click="KeepnetClick"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" Margin="0,0,8,0" Background="#171C22" CornerRadius="8"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#98A3B3" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xEA37;"/></Border>
                            <TextBlock Text="Садок"/>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="BaitsButton"
                        Click="BaitsClick"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" Margin="0,0,8,0" Background="#171C22" CornerRadius="8"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#98A3B3" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE8A5;"/></Border>
                            <TextBlock Text="Наживки"/>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="FishCatalogButton"
                        Click="FishCatalogClick"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" Margin="0,0,8,0" Background="#171C22" CornerRadius="8"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#98A3B3" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE8B1;"/></Border>
                            <TextBlock Text="Каталог рыбы"/>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="AnalyticsButton"
                        Click="AnalyticsClick"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" Margin="0,0,8,0" Background="#171C22" CornerRadius="8"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#98A3B3" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE9D2;"/></Border>
                            <TextBlock Text="Аналитика"/>
                        </StackPanel>
                    </Button>

                    <TextBlock
                        x:Name="SystemSectionLabel"
                        Margin="12,27,0,9"
                        Foreground="#697586"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Text="СИСТЕМА"/>
                    <Button
                        x:Name="SettingsButton"
                        Click="SettingsClick"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" Margin="0,0,8,0" Background="#171C22" CornerRadius="8"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#98A3B3" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE713;"/></Border>
                            <TextBlock Text="Настройки"/>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="HelpButton"
                        Click="HelpClick"
                        Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" Margin="0,0,8,0" Background="#171C22" CornerRadius="8"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#98A3B3" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE897;"/></Border>
                            <TextBlock Text="Помощь"/>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="SidebarToggleButton"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Left"
                        Click="ToggleSidebarClick"
                        Style="{StaticResource FluentIconButtonStyle}"
                        Content="&#xE76B;"
                        ToolTip="Свернуть навигацию"/>
                </StackPanel>

                <Border
                    x:Name="GameStatusCard"
                    DockPanel.Dock="Bottom"
                    Margin="16,0,16,18"
                    Padding="12"
                    Background="#12171D"
                    BorderBrush="#28313C"
                    BorderThickness="1"
                    CornerRadius="11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="8"
                                Height="8"
                                Margin="0,0,8,0"
                                Fill="#72BC8F"/>
                            <TextBlock FontWeight="SemiBold" Text="Игра подключена"/>
                        </StackPanel>
                        <TextBlock
                            Margin="0,7,0,0"
                            Style="{StaticResource SmallLabelStyle}"
                            Text="{Binding GameBindingStatus}"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="32,0"
                BorderBrush="#222B35"
                BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SmallLabelStyle}" Text="Рабочее пространство"/>
                        <TextBlock x:Name="PageTitleText" Margin="0,2,0,0" FontSize="19" FontWeight="SemiBold" Text="/  Обзор"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button
                            Margin="8,0,0,0"
                            Command="{Binding ImportCommand}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="⇧  Импорт"
                            ToolTip="Восстановить данные из RF4 backup"/>
                        <Button
                            Margin="8,0,0,0"
                            Command="{Binding ExportCommand}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="⇩  Экспорт"
                            ToolTip="Создать резервную копию данных"/>
                        <Button
                            Margin="8,0,0,0"
                            Click="BindGameClick"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="⌘  Привязать игру"
                            ToolTip="Найти запущенное окно Russian Fishing 4"/>
                        <Button
                            Margin="8,0,0,0"
                            Click="CaptureScreenshotClick"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="◉  Быстрый снимок"
                            MinWidth="160"
                            ToolTip="Снимок карточки улова · Space"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer
                x:Name="MainScrollViewer"
                Grid.Row="1"
                Padding="32,28,32,24"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock
                        Foreground="#63A8FF"
                        FontSize="11"
                        FontWeight="Bold"
                        Text="ЦЕНТР УПРАВЛЕНИЯ"/>
                    <TextBlock
                        Margin="0,5,0,0"
                        FontSize="32"
                        FontWeight="SemiBold"
                        Text="Добрый день"/>
                    <TextBlock
                        Margin="0,5,0,0"
                        Foreground="#98A3B3"
                        Text="Все последние уловы и подсказки — в одном месте."/>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*"/>
                            <ColumnDefinition Width="0.75*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Background="#12171D">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Border
                                        Style="{StaticResource StatusBadgeStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="#72BC8F"/>
                                            <TextBlock Foreground="#8FC1FF" FontSize="11" FontWeight="Bold" Text="ОКНО ИГРЫ АКТИВНО"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="0,12,0,0" FontSize="24" FontWeight="SemiBold" Text="Сегодня на воде"/>
                                    <TextBlock Margin="0,5,0,0" Foreground="#AAB4C2" Text="Нажмите Space, чтобы сохранить карточку поимки."/>
                                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                        <StackPanel Margin="0,0,34,0">
                                            <TextBlock FontSize="25" FontWeight="Bold" Text="{Binding Summary.TotalCatches}"/>
                                            <TextBlock Style="{StaticResource SmallLabelStyle}" Text="уловов за период"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,34,0">
                                            <TextBlock FontSize="25" FontWeight="Bold" Text="{Binding Summary.BestWeightDisplay}"/>
                                            <TextBlock Style="{StaticResource SmallLabelStyle}" Text="лучший улов"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock FontSize="25" FontWeight="Bold" Foreground="#EAC26B" Text="{Binding Summary.AverageWeightDisplay}"/>
                                            <TextBlock Style="{StaticResource SmallLabelStyle}" Text="средний вес"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button
                                            Width="205"
                                            Height="42"
                                            Click="CaptureScreenshotClick"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Content="◉  Сделать снимок улова"
                                            />
                                        <Button
                                            Width="125"
                                            Height="42"
                                            Margin="8,0,0,0"
                                            Click="CaptureCafeClick"
                                            Content="▣  Скрин кафе"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button
                                            Width="165"
                                            Height="42"
                                            Click="ArmBaitRecognitionClick"
                                            Content="⌖  Определить наживку"
                                            ToolTip="Активировать одноразовый снимок снасти по клавише V"/>
                                        <Button
                                            Width="165"
                                            Height="42"
                                            Margin="8,0,0,0"
                                            Click="ArmWaterBodyRecognitionClick"
                                            Content="⌖  Определить водоём"
                                            ToolTip="Активировать одноразовый снимок карты по клавише M"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="18,4,0,0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource SmallLabelStyle}"
                                    Text="Готово к Space"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Следующее действие"/>
                                    <Border DockPanel.Dock="Right" Padding="8,5" Background="#172A43" CornerRadius="12">
                                        <TextBlock Foreground="#8FC1FF" FontSize="11" Text="3 шага"/>
                                    </Border>
                                </DockPanel>
                                <StackPanel Margin="0,15,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="24" Height="24" Background="#183528" CornerRadius="12">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#72BC8F" Text="✓"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock FontWeight="SemiBold" Text="Игра подключена"/>
                                            <TextBlock Style="{StaticResource SmallLabelStyle}" Text="Окно RF4 найдено"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="24" Height="24" Background="#183528" CornerRadius="12">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#72BC8F" Text="✓"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock FontWeight="SemiBold" Text="OCR готов"/>
                                            <TextBlock Style="{StaticResource SmallLabelStyle}" Text="Русский язык активен"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="24" Height="24" Background="#2A2B20" CornerRadius="12">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#EAC26B" Text="3"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock FontWeight="SemiBold" Text="Проверьте кафе"/>
                                            <TextBlock Style="{StaticResource SmallLabelStyle}" Text="Снимок даст предложения"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <UniformGrid Columns="4" Margin="0,0,0,0">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SmallLabelStyle}" Text="ЛУЧШИЙ УЛОВ"/>
                                <TextBlock Margin="0,7,0,0" FontSize="20" FontWeight="Bold" Text="{Binding Summary.BestFish}"/>
                                <TextBlock Style="{StaticResource SmallLabelStyle}" Text="{Binding Summary.BestWeightDisplay}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SmallLabelStyle}" Text="ЛУЧШИЙ ВОДОЁМ"/>
                                <TextBlock Margin="0,7,0,0" FontSize="20" FontWeight="Bold" Text="{Binding Summary.BestWaterBody}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Style="{StaticResource SmallLabelStyle}" Text="по максимальному улову"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SmallLabelStyle}" Text="СРЕДНИЙ ВЕС"/>
                                <TextBlock Margin="0,7,0,0" FontSize="20" FontWeight="Bold" Text="{Binding Summary.AverageWeightDisplay}"/>
                                <TextBlock Style="{StaticResource SmallLabelStyle}" Text="за выбранный период"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SmallLabelStyle}" Text="ИСТОЧНИК ДАННЫХ"/>
                                <TextBlock
                                    Margin="0,7,0,0"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Text="{Binding DataSourceLabel}"
                                    TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource SmallLabelStyle}" Text="локальная история"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Последние рыбы"/>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SmallLabelStyle}"
                                    Text="карточки уловов"
                                    TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding VisibleCatches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="190" Height="104" Margin="0,0,10,0"
                                                    Padding="10"
                                                    Background="#151A20"
                                                    BorderBrush="#2B3642"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="38" Height="38" Background="#182C24" CornerRadius="19" VerticalAlignment="Top">
                                                        <Grid>
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" Text="🐟"/>
                                                            <Image Margin="4" Source="{Binding FishImagePath}" Stretch="Uniform"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding FishName}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Margin="0,4,0,0" Foreground="#63A8FF" FontSize="18" FontWeight="Bold" Text="{Binding WeightDisplay}"/>
                                                        <TextBlock Style="{StaticResource SmallLabelStyle}" Text="{Binding WaterBodyName}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Style="{StaticResource SmallLabelStyle}" Text="{Binding CaughtAt, StringFormat={}{0:dd.MM HH:mm}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
