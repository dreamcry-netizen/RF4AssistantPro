                                        Grid.Column="1"
                                        MinWidth="112"
                                        Padding="12,5"
                                        Click="CaptureCafeClick"
                                        Content="Скрин кафе"/>
                                    <Button
                                        Grid.Column="2"
                                        MinWidth="118"
                                        Margin="8,0,0,0"
                                        Padding="12,5"
                                        Click="ImportCafeClick"
                                        Content="Открыть PNG"
                                        ToolTip="Повторно распознать сохранённый снимок кафе"/>
                                    <Button
                                        Grid.Column="3"
                                        MinWidth="112"
                                        Margin="8,0,0,0"
                                        Padding="12,5"
                                        Click="CafeOcrAliasesClick"
                                        Content="OCR-словарь"
                                        ToolTip="Просмотреть и изменить обученные названия"/>
                                </Grid>
                                <Border Style="{StaticResource InlineInfoBarStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,9,0" Foreground="#CFE8D8" FontSize="17" Text="✦"/>
