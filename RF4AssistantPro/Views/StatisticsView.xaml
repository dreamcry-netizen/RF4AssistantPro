                                    <Button Width="155" Height="40" Click="OpenFishProfileClick" Content="Открыть карточку"/>
                                    <Button Width="205" Height="40" Click="OpenFishCatalogClick" Content="Каталог и редактирование"/>
                                    <Button Width="145" Height="40" Margin="10,0,0,0" Background="#4E96EF" Click="AddFishClick" Content="Добавить рыбу"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

