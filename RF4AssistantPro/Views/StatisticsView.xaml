                                           Style="{StaticResource SmallLabelStyle}"
                                           Text="{Binding Diagnostics.HealthText}"/>
                            </Grid>
                            <TextBlock Foreground="#98A3B3"
                                       Text="{Binding Diagnostics.EnvironmentText}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#98A3B3"
                                       Text="{Binding Diagnostics.StorageText}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#98A3B3"
                                       Text="{Binding Diagnostics.MediaText}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#98A3B3"
                                       Text="{Binding Diagnostics.LogText}"
                                       TextWrapping="Wrap"/>
