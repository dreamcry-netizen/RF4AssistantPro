                                        Margin="0,10,0,0"
                                        Background="#4E96EF"
                                        Click="AddBaitClick"
                                        Content="Добавить наживку"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Margin="0,22,0,0"
                            MaxWidth="1100"
                            HorizontalAlignment="Left"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="Добавленные наживки"/>
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource SmallLabelStyle}"
                                               Text="{Binding BaitCatalogCountText}"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Width="170"
                                        Height="38"
                                        Margin="12,0,0,0"
                                        Click="OpenBaitCatalogClick"
                                        Content="Открыть каталог"/>
                                <Button Grid.Column="2"
                                        Width="170"
                                        Height="38"
                                        Margin="10,0,0,0"
                                        Background="#4E96EF"
                                        Click="AddBaitClick"
                                        Content="+ Добавить наживку"/>
                            </Grid>

                            <StackPanel Margin="0,0,0,12"
                                        Orientation="Horizontal">
                                <TextBlock Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SmallLabelStyle}"
                                           Text="Сортировать по:"/>
                                <ComboBox x:Name="BaitSortFieldBox"
                                          Width="190"
                                          Height="36"
                                          SelectedIndex="0">
                                    <ComboBoxItem Tag="DisplayName"
                                                  Content="Названию"/>
                                    <ComboBoxItem Tag="Brand"
                                                  Content="Производителю"/>
                                    <ComboBoxItem Tag="Category"
                                                  Content="Категории"/>
                                    <ComboBoxItem Tag="Subcategory"
                                                  Content="Подкатегории"/>
                                </ComboBox>
                                <Button x:Name="BaitSortButton"
                                        Width="160"
                                        Height="36"
                                        Margin="10,0,0,0"
                                        Click="SortBaitsClick"
                                        Content="Сортировать А–Я"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12"
                                        Orientation="Horizontal">
                                <TextBlock Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SmallLabelStyle}"
                                           Text="Отображать:"/>
                                <ComboBox x:Name="BaitCategoryFilterBox"
                                          Width="230"
                                          Height="36"
                                          ItemsSource="{Binding BaitCategories}"
                                          SelectedItem="{Binding SelectedBaitCategoryFilter,
                                              Mode=TwoWay}"
                                          ToolTip="Выберите категорию"/>
                                <ComboBox x:Name="BaitSubcategoryFilterBox"
                                          Width="210"
                                          Height="36"
                                          Margin="10,0,0,0"
                                          ItemsSource="{Binding BaitSubcategories}"
                                          SelectedItem="{Binding SelectedBaitSubcategoryFilter,
                                              Mode=TwoWay}"
                                          ToolTip="Выберите подкатегорию"/>
                                <Button Width="150"
                                        Height="36"
                                        Margin="10,0,0,0"
                                        Background="#4E96EF"
                                        Click="ShowSelectedBaitsClick"
                                        Content="Показать выбранное"/>
                                <Button Width="105"
                                        Height="36"
                                        Margin="10,0,0,0"
                                        Click="ShowAllBaitsClick"
                                        Content="Показать все"/>
                            </StackPanel>

                            <DataGrid x:Name="BaitCatalogPageGrid"
                                      MinWidth="1000"
                                      MinHeight="180"
                                      MaxHeight="520"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding BaitCatalog}"
                                      MouseDoubleClick="EditSelectedBaitDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="76">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Width="56"
                                                        Height="56"
                                                        Margin="4"
                                                        Background="#0E1115"
                                                        CornerRadius="5">
                                                    <Image Source="{Binding ImagePath}"
                                                           Stretch="Uniform"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Название"
                                                        Width="1.35*"
                                                        Binding="{Binding DisplayName}"/>
                                    <DataGridTextColumn Header="Производитель"
                                                        Width="1*"
                                                        Binding="{Binding Brand}"/>
                                    <DataGridTextColumn Header="Категория"
                                                        Width="1.35*"
                                                        Binding="{Binding Category}"/>
                                    <DataGridTextColumn Header="Подкатегория"
                                                        Width="1.15*"
                                                        Binding="{Binding Subcategory}"/>
                                    <DataGridTextColumn Header="Варианты OCR"
                                                        Width="1.7*"
                                                        Binding="{Binding Aliases}"/>
                                    <DataGridCheckBoxColumn Header="Активна"
                                                            Width="85"
                                                            Binding="{Binding IsEnabled}"/>
                                    <DataGridTemplateColumn Header=""
                                                            Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Width="105"
                                                        Height="34"
                                                        Tag="{Binding}"
                                                        Click="EditBaitClick"
                                                        Content="Редактировать"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource SmallLabelStyle}"
                                       Text="Двойной щелчок по строке также открывает редактирование."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

