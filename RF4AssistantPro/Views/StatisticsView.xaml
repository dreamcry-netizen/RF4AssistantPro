                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding WaterBodyName}" Header="Водоём" Width="1.4*"/>
                                        <DataGridTemplateColumn Header="Наживка" Width="165">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Width="28" Height="28" Margin="0,2,7,2"
